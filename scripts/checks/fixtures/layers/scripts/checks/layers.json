{
  "import_patterns": { ".py": ["^\\s*from\\s+([\\w.]+)\\s+import", "^\\s*import\\s+([\\w.]+)"] },
  "layers": [
    { "name": "models", "paths": ["**/models.py"], "modules": ["\\.models$"], "may_import": [] },
    { "name": "api", "paths": ["**/views.py"], "modules": ["\\.views$"], "may_import": ["models"] }
  ]
}
